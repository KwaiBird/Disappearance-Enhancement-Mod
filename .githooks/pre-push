#!/bin/sh

zero_oid='0000000000000000000000000000000000000000'
failed=0

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main)
            if [ "$local_ref" != refs/heads/main ] || [ "$local_oid" = "$zero_oid" ]; then
                echo "Rejected: only a non-deletion update from local main may update remote main." >&2
                failed=1
            fi
            ;;
        refs/heads/*)
            echo "Rejected: pushing branches other than main is disabled (target: $remote_ref)." >&2
            failed=1
            ;;
    esac
done

exit "$failed"
