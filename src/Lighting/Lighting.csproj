<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Disappearance.Lighting</AssemblyName>
    <RootNamespace>Disappearance.Lighting</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(P5HaloDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);P5_HALO_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(P5HaloDiagnostics)' == 'true'">
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GameRoot)\Disappearance_Data\Managed\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
